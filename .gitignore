# Rust
/target/
**/*.rs.bk
*.pdb
Cargo.lock.orig

# Python tooling (tools/vectorgen). Byte-code caches carry no SPDX header and
# would fail the REUSE check if they were ever committed.
__pycache__/
*.py[cod]
.venv/
venv/

# Simulation output
/sim-out/
*.csv.tmp

# LaTeX (paper drafts)
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk
*.toc

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Secrets — never commit key material
*.key
*.pem
/keys/
